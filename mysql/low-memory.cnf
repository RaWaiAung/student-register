# MySQL 8.4 tuned for a 1 GB RAM instance (AWS Free Tier t2/t3.micro)
[mysqld]
performance_schema      = OFF
innodb_buffer_pool_size = 64M
innodb_log_buffer_size  = 8M
key_buffer_size         = 8M
max_connections         = 30
table_open_cache        = 200
thread_cache_size       = 8
tmp_table_size          = 16M
max_heap_table_size     = 16M
skip-name-resolve
